# Storage / public URL
SHIN_IMAGE_ROOT=/mnt/storage/shincabinet-images
SHIN_STORAGE_MOUNT=/mnt/storage
SHIN_REQUIRE_STORAGE_MOUNT=1
SHIN_PUBLIC_BASE_URL=https://images.shincabinet.com

# Image manager web UI. Keep bound to localhost when using Cloudflare Tunnel.
SHIN_IMAGE_MANAGER_HOST=127.0.0.1
SHIN_IMAGE_MANAGER_PORT=8090

# REQUIRED. Use a strong password and random session secret.
SHIN_IMAGE_MANAGER_PASSWORD=replace-with-a-long-password
SHIN_IMAGE_MANAGER_SECRET=replace-with-at-least-32-random-characters
# Optional: leave blank unless another trusted tool (such as Site Manager) needs API access.
SHIN_IMAGE_MANAGER_API_TOKEN=

# Upload/thumbnail behavior
SHIN_IMAGE_MANAGER_MAX_UPLOAD_MB=512
SHIN_USE_CLOUDFLARE_THUMBNAILS=1
SHIN_THUMBNAIL_SIZE=480
SHIN_SECURE_COOKIE=1
